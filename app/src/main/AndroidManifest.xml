<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiChatSample"
        >

        <!--
        Every screen is locked to portrait. The app is designed portrait-only (no landscape
        layouts exist), and a rotation-triggered recreate would otherwise destroy the Activity
        mid-generation - lifecycleScope cancels on real onDestroy(), unlike the merely-backgrounded
        case handled by simply not cancelling generationJob in onStop() anymore (see ChatActivity/
        GroupChatActivity) - so this is what keeps a reply from being silently discarded by
        rotating the phone while it's still being generated.
        -->

        <activity
            android:name=".CharacterGalleryActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CharacterSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AvatarCropActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".GroupSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GroupChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
