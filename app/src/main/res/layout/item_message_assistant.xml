<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/msg_avatar_tile"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/msg_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <TextView
            android:id="@+id/msg_avatar_letter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="13sp"
            style="@style/TextAppearance.CharChat.AvatarLetter" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Group chat only: which character this bubble belongs to. Gone in solo chats. -->
        <TextView
            android:id="@+id/msg_speaker_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone"
            style="@style/TextAppearance.CharChat.Body.LabelSmall" />

        <TextView
            android:id="@+id/msg_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_assistant_message"
            android:padding="12dp"
            android:textColor="@color/on_background" />

        <LinearLayout
            android:id="@+id/thinking_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_assistant_message"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <View
                android:id="@+id/dot_1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_thinking" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/dot_thinking" />

            <View
                android:id="@+id/dot_3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/dot_thinking" />

        </LinearLayout>

        <!-- Only shown on the most recent reply. -->
        <ImageView
            android:id="@+id/msg_regenerate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="-6dp"
            android:padding="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_redo_24"
            android:tint="@color/on_surface_faint"
            android:contentDescription="Regenerate reply"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
