<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="4dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:id="@+id/select_avatar_tile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/avatar_bg_green">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/select_avatar_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/select_avatar_letter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="15sp"
            style="@style/TextAppearance.CharChat.AvatarLetter" />

    </FrameLayout>

    <TextView
        android:id="@+id/select_name"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/on_background"
        android:maxLines="1"
        android:ellipsize="end"
        style="@style/TextAppearance.CharChat.Body.BodyMedium" />

    <CheckBox
        android:id="@+id/select_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        app:buttonTint="@color/primary" />

</LinearLayout>
