<?xml version="1.0" encoding="utf-8"?>
<!--
   Only applies pre-API 31 (this app's minSdk is 33, so data_extraction_rules.xml is what
   actually governs backups today) - kept in sync anyway in case minSdk is ever lowered.
   Downloaded GGUF models can be multiple gigabytes; excluded so a full backup doesn't try to
   include them.
-->
<full-backup-content>
    <exclude domain="file" path="models/" />
</full-backup-content>
